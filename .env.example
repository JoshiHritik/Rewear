# -----------------------------------------------------------------------------
# Supabase PostgreSQL Database Settings
# (Get from Supabase Dashboard -> Project Settings -> Database -> Connection string)
# -----------------------------------------------------------------------------
# Transaction pooler URL (Port 6543, for serverless / Prisma runtime queries)
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (Port 5432, for Prisma migrations)
DIRECT_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase API & Cloud Storage Bucket Settings
# (Get from Supabase Dashboard -> Project Settings -> API & Storage)
# -----------------------------------------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_BUCKET="rewear-images"

# Frontend Vite client variables
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# Supabase Auth & Google OAuth Setup Notes
# -----------------------------------------------------------------------------
# 1. Supabase Site URL: https://rewear-frontend-4k4i.vercel.app/
# 2. Redirect URLs to add in Supabase (Authentication -> URL Configuration):
#    - https://rewear-frontend-4k4i.vercel.app/auth/callback
#    - http://localhost:5173/auth/callback
# 3. Google OAuth Setup:
#    - Enable Google provider under Supabase Dashboard -> Authentication -> Providers -> Google
#    - In Google Cloud Console, set Authorized Redirect URI to: https://[YOUR-PROJECT-REF].supabase.co/auth/v1/callback

# Server Settings
JWT_SECRET="rewear-super-secret-key-12345"
PORT=4000


