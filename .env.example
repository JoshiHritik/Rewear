# -----------------------------------------------------------------------------
# Supabase PostgreSQL Database Settings
# (Get from Supabase Dashboard -> Project Settings -> Database -> Connection string)
# -----------------------------------------------------------------------------
# Transaction pooler URL (Port 6543, for serverless / Prisma runtime queries)
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (Port 5432, for Prisma migrations)
DIRECT_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase API & Cloud Storage Bucket Settings
# (Get from Supabase Dashboard -> Project Settings -> API & Storage)
# -----------------------------------------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_BUCKET="rewear-images"

# Frontend Vite client variables
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server Settings
JWT_SECRET="rewear-super-secret-key-12345"
PORT=4000

